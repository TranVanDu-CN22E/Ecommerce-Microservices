{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=identity-db;Port=5435;Database=ecommerce_identity;Username=ecommerce_identity;Password=ecommerce_identity_pw",
    "Redis": "redis:6379,abortConnect=false"
  },
  "Jwt": {
    "Key": "development-only-change-this-to-a-secure-32-character-minimum-secret",
    "Issuer": "e-shop-identity",
    "Audience": "e-shop-client",
    "AccessTokenExpireMinutes": 10
  },
  "JwtSystem": {
    "SigningKey": "development-only-change-this-to-a-separate-secure-service-secret",
    "Issuer": "e-shop-internal",
    "Audience": "e-shop-services"
  },
  //phải sửa Email-Example thành Email
  "Email-Example": {
    "SenderEmail": "example@gmail.com",
    "SenderName": "E-Shop",
    "SenderPassword": "example",
    "SmtpServer": "smtp.gmail.com",
    "Port": 587
  }
}
