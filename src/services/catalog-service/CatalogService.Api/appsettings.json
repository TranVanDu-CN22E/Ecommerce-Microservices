{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=catalog-db;Port=5436;Database=ecommerce_catalog;Username=ecommerce_catalog;Password=ecommerce_catalog_pw"
  },
  "Jwt": {
    "Key": "development-only-change-this-to-a-secure-32-character-minimum-secret",
    "Issuer": "e-shop-identity",
    "Audience": "e-shop-client",
    "AccessTokenExpireMinutes": 10
  },
  "LocalFileStorage": {
    "BasePath": "wwwroot/uploads"
  },
  "GrpcSettings": {
    "IdentityServiceUrl": "http://identity-api:8081"
  },
  "Redis": {
    "ConnectionString": "localhost:6380,password=yourpassword,ssl=False,abortConnect=False",
    "DefaultTTLMinutes": 5,
    "KeyPrefix": "catalog:"
  }
}
