{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "Cors": {
      "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173", "https://api.localhost" ],
      "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS" ],
      "AllowedHeaders": [ "Authorization", "Content-Type", "X-Requested-With" ],
      "AllowCredentials": true
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-service": {
        "Destinations": {
          "primary": { "Address": "http://identity-api:8080/" }
        }
      },
      "catalog-service": {
        "Destinations": {
          "primary": { "Address": "http://catalog-api:8080/" }
        }
      }
    }
  }
}
